{
  "name": "atc-simulator",
  "version": "2.0.0",
  "private": true,
  "description": "ATC2.0 browser edition, Web Speech API, static hosting",
  "type": "module",
  "scripts": {
    "test": "node scripts/build-test-site.cjs && npm --prefix online test && node scripts/check-site.cjs && node --test tests/analytics.test.cjs tests/local-admin.test.cjs",
    "build": "node scripts/build-site.cjs",
    "typecheck": "tsc -p online/tsconfig.json --noEmit && tsc -p local/tsconfig.json --noEmit",
    "test:ui": "node scripts/build-test-site.cjs && node online/scripts/test-browser-ui.cjs",
    "preview": "node scripts/preview.cjs",
    "test:analytics": "node scripts/build-test-site.cjs && node --test tests/analytics.test.cjs",
    "test:analytics:rules": "npm --prefix tests/firebase test",
    "test:analytics:browser": "npm run build && node tests/analytics-browser.cjs",
    "admin": "node scripts/open-admin.cjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.24.0",
    "@babel/preset-typescript": "^7.24.0",
    "@playwright/test": "^1.44.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.4.5"
  }
}
