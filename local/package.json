{
  "name": "atc-command-v9",
  "version": "9.0.0",
  "private": true,
  "description": "ATC COMMAND V9.0 - Air Traffic Control Simulator with SenseVoice Small + Aviation Phraseology Normalizer + Kokoro TTS",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-standalone.cjs",
